{# @prop type string|null Input type attribute, default to `text` #}
{# @prop name string Input name attribute #}
{# @prop value string Input value attribute #}
{# @prop placeholder string|null #}
{# @prop data_model string|null Stimulus/LiveComponent data-model binding #}
{# @prop required bool #}
{# @prop disabled bool #}
<input
    type="{{ type|default('text') }}"
    name="{{ name }}"
    value="{{ value }}"
    {% if data_model %}data-model="{{ data_model }}"{% endif %}
    {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
    class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground focus:border-ring focus:ring-2 focus:ring-ring/20 outline-none transition{{ disabled ? ' opacity-50 cursor-not-allowed bg-muted' : '' }}"
    {% if required %}required{% endif %}
    {% if disabled %}disabled{% endif %}
/>
