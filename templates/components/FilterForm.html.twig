<div {{ attributes }}>
    <twig:DataTable:Card>
        {{ form_start(form, {action: actionUrl}) }}

        {# Quick search: the placeholder says what it is, the label stays for screen readers #}
        <div class="mb-4">
            {{ form_label(form.search, null, {label_attr: {class: 'sr-only'}}) }}
            {{ form_widget(form.search) }}
            {{ form_errors(form.search) }}
        </div>

        {# Dynamic Filter Collection - LiveCollectionType handles add/remove #}
        <div class="space-y-4">
            {{ form_row(form.filters) }}
        </div>
        <twig:DataTable:ButtonRow class="mt-6">
            <twig:DataTable:Button:Button type="submit" variant="primary">
                {{ 'action.apply_filters'|trans({}, 'datatable') }}
            </twig:DataTable:Button:Button>
            <twig:DataTable:Button:Link href="{{ actionUrl }}" variant="outline">
                {{ 'action.clear_filters'|trans({}, 'datatable') }}
            </twig:DataTable:Button:Link>
        </twig:DataTable:ButtonRow>

        {{ form_widget(form.page) }}
        {{ form_widget(form.sort) }}
        {{ form_widget(form.direction) }}
        {% do form.page.setRendered %}
        {% do form.sort.setRendered %}
        {% do form.direction.setRendered %}
        {{ form_end(form) }}
    </twig:DataTable:Card>
</div>
