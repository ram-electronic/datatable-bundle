{# @prop align 'left'|'center'|'right' Text alignment #}
{# @prop bold bool Whether to make text bold #}
{# @block content The default block #}
{%- set style = html_cva(
    base: 'p-4 align-middle [&:has([role=checkbox])]:pr-0',
    variants: {
        align: {
            left: 'text-left',
            center: 'text-center',
            right: 'text-right',
        },
    },
) -%}
<td
    class="{{ style.apply({align: align}, attributes.render('class') ~ (bold ? ' font-semibold' : ''))|tailwind_merge }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</td>
