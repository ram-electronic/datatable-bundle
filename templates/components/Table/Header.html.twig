{# @prop align 'left'|'center'|'right' Text alignment #}
{# @block content The default block #}
{%- set style = html_cva(
    base: 'h-12 px-4 font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0',
    variants: {
        align: {
            left: 'text-left',
            center: 'text-center',
            right: 'text-right',
        },
    },
) -%}
<th
    class="{{ style.apply({align: align}, attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</th>
