<twig:DataTable:Button:Link
    aria-label="{{ 'pagination.aria.next'|trans({}, 'datatable') }}"
    variant="ghost"
    size="default"
    class="{{ ('gap-1 pr-2.5 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ ...attributes.without('class') }}
>
    <span>{{ 'pagination.next'|trans({}, 'datatable') }}</span>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18l6-6l-6-6"/></svg>
</twig:DataTable:Button:Link>
