<twig:DataTable:Button:Link
    aria-label="{{ 'pagination.aria.next'|trans({}, 'datatable') }}"
    variant="ghost"
    size="default"
    class="{{ ('gap-1 pr-2.5 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ ...attributes.without('class') }}
>
    <span>{{ 'pagination.next'|trans({}, 'datatable') }}</span>
    <twig:ux:icon name="lucide:chevron-right" class="size-4" />
</twig:DataTable:Button:Link>
